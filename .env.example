# Culqi — https://culqi.com (panel: https://integ-panel.culqi.com en test)
# La llave pública se expone al navegador; la secreta SOLO vive en el servidor.
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Supabase — libro de reclamaciones. Ambas son server-only:
# el formulario escribe a través de app/api/reclamaciones, nunca desde el navegador.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxx

# Resend — aviso por email a Jaime en cada reclamo nuevo.
# Si quedan vacías, el reclamo igual se registra (solo no se envía el aviso).
RESEND_API_KEY=re_xxxxxxxxxxxx
RECLAMOS_EMAIL_TO=correo-del-negocio@ejemplo.com

# Panel de pedidos — Basic Auth. Sin estas dos, /admin devuelve 503.
ADMIN_USER=usuario
ADMIN_PASSWORD=una-clave-larga
